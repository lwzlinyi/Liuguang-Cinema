<Page
    x:Class="TV.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TV.Controls"
    xmlns:local="using:TV.Converters"
    Background="Transparent"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
        <local:BoolToFavoriteConverter x:Key="FavoriteText" />
        <Style x:Key="ChannelRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource NavRailItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="{StaticResource ListRowHeight}" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePaddingWide}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 / 副信息 + 搜索 / 刷新 / 网络串流 -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SpaceTiny}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}" VerticalAlignment="Center">
                    <TextBlock Text="直播" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="{StaticResource RadiusTag}"
                            Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" Style="{StaticResource MetaText}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                <TextBox Width="220" PlaceholderText="搜索频道"
                         AutomationProperties.Name="搜索"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ReloadCommand}"
                        ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新">
                    <FontIcon Glyph="&#xE72C;" FontSize="18" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="打开网络串流"
                        AutomationProperties.Name="打开网络串流">
                    <FontIcon Glyph="&#xE71B;" FontSize="18" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="288" Spacing="{StaticResource SpaceSmall}">
                                <TextBox Header="网络串流" PlaceholderText="https://"
                                         Text="{Binding DirectUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="播放" Command="{Binding PlayDirectCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"
                                        AutomationProperties.Name="播放" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 窄窗返回条：源/分组 → 频道 → 详情 单任务切换 -->
        <StackPanel x:Name="NarrowNav" Grid.Row="1" Orientation="Horizontal"
                    Spacing="{StaticResource SpaceSmall}" Margin="0,12,0,0" Visibility="Collapsed">
            <Button x:Name="NarrowBackButton" Style="{StaticResource IconButtonStyle}" Click="OnNarrowBackClick"
                    ToolTipService.ToolTip="返回" AutomationProperties.Name="返回上级">
                <FontIcon Glyph="&#xE72B;" FontSize="18" />
            </Button>
            <TextBlock x:Name="NarrowStageText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 主体：源 / 分组 + 频道 + 频道详情，三列顶部对齐、列间距 24 -->
        <Grid x:Name="BodyGrid" Grid.Row="2" Margin="0,16,0,0"
              ColumnSpacing="{StaticResource SpaceLarge}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourcesColumn" Width="280" />
                <ColumnDefinition x:Name="ChannelsColumn" Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftPanel" Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}" Padding="14">
                <Grid RowSpacing="{StaticResource SpaceMedium}">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="SourceRow" Height="Auto" />
                        <RowDefinition x:Name="GroupRow" Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 内置与导入直播源共用一个选择器。 -->
                    <StackPanel x:Name="SourceSection" Spacing="{StaticResource SpaceSmall}">
                        <Grid ColumnSpacing="{StaticResource SpaceMini}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="直播源" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button Content="添加" Click="OnAddSourceClick" Style="{StaticResource GhostButtonStyle}"
                                        Padding="8,0" MinHeight="26" Height="26" AutomationProperties.Name="添加直播源"
                                        ToolTipService.ToolTip="添加直播源（m3u/m3u8 地址）" />
                                <Button Content="删除" Click="OnRemoveSourceClick" Style="{StaticResource GhostButtonStyle}"
                                        Padding="8,0" MinHeight="26" Height="26" AutomationProperties.Name="删除直播源"
                                        ToolTipService.ToolTip="删除当前选中的自定义直播源" />
                            </StackPanel>
                        </Grid>
                        <controls:AnchoredChoice ItemsSource="{Binding AvailableSources}"
                                                 SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                                                 DisplayMemberPath="Name" PlaceholderText="内置直播源"
                                                 HorizontalAlignment="Stretch" />
                        <Grid ColumnSpacing="{StaticResource SpaceMini}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="无导入源时默认使用内置源" Style="{StaticResource MetaText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="查看内置频道"
                                    Command="{Binding SelectBuiltInCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    AutomationProperties.Name="查看内置频道" />
                        </Grid>
                    </StackPanel>

                    <!-- 第二级：分组（分组列表为空时由 code-behind 隐藏整块，不再出现只有标题的空分组区） -->
                    <Grid x:Name="GroupSection" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="分组" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                        <ListView Grid.Row="1" ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                  SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  ItemContainerStyle="{StaticResource RailListStyle}"
                                  SelectionChanged="OnGroupSelectionChanged"
                                  ScrollViewer.HorizontalScrollMode="Disabled" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 频道列表（每项为聚合后的频道，含线路数与清晰度） -->
            <Grid x:Name="ChannelsPanel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="{StaticResource SpaceMini}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="频道" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ChannelsSummary}" Style="{StaticResource MetaText}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <ListView x:Name="ChannelList" ItemsSource="{Binding Channels}"
                              ItemContainerStyle="{StaticResource ChannelRowStyle}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0"
                              DoubleTapped="OnChannelDoubleTapped"
                              SelectionChanged="OnChannelSelectionChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="{StaticResource ListRowHeight}" ColumnSpacing="{StaticResource SpaceSmall}"
                                      Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Padding="5"
                                            Background="{ThemeResource SurfaceAltBrush}"
                                            BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image controls:PosterImage.CachedSource="{Binding Logo}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceTiny}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource MetaText}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="16"
                                              Foreground="{ThemeResource TertiaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 加载态 -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing IsActive="True" Width="24" Height="24" />
                        <TextBlock Text="正在加载直播频道…" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 空 / 错误态 -->
                    <StackPanel MaxWidth="400" Spacing="{StaticResource SpaceSmall}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE783;" FontSize="40"
                                  Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitleText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="重新加载" Command="{Binding ReloadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"
                                AutomationProperties.Name="重新加载频道" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 频道详情：节目单、线路（清晰度 13px）与播放/收藏 -->
            <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource PanelCardStyle}"
                    VerticalAlignment="Stretch">
                <Grid>
                    <StackPanel MaxWidth="280" Spacing="{StaticResource SpaceSmall}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedChannel, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <FontIcon Glyph="&#xE7F4;" FontSize="40"
                                  Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="选择一个频道" Style="{StaticResource SectionTitleText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="查看节目单与全部线路，双击频道可直接播放" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Visibility="{Binding HasSelectedChannel, Converter={StaticResource BoolToVisibility}}"
                          RowSpacing="{StaticResource SpaceMedium}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="{StaticResource SpaceTiny}">
                            <TextBlock Text="{Binding SelectedChannel.Name}" Style="{StaticResource SectionTitleText}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                <TextBlock Text="{Binding SelectedItem.MetaText}" Style="{StaticResource MetaText}" />
                                <TextBlock Text="·" Style="{StaticResource MetaText}" />
                                <TextBlock Text="{Binding SelectedChannel.Group}" Style="{StaticResource MetaText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProgramInfo}" Style="{StaticResource SecondaryText}"
                                       Margin="0,4,0,0" MaxLines="4" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ProgramInfo, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="线路" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                            <ListView Grid.Row="1" ItemsSource="{Binding SelectedItem.Lines}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnLineClick"
                                      Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="{StaticResource ListRowHeight}"
                                              ColumnSpacing="{StaticResource SpaceSmall}" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource BodyText}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MetaText}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE768;" FontSize="16"
                                                      Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}"
                                    Margin="0,16,0,0">
                            <Button Content="播放" Command="{Binding PlayChannelCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="播放频道" />
                            <Button Content="{Binding IsFavorite, Converter={StaticResource FavoriteText}}"
                                    Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="收藏频道" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
