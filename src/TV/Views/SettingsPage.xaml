                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="数据目录与占用统计" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                                            <Button Content="刷新统计" Command="{Binding RefreshStorageCommand}" Style="{StaticResource GhostButtonStyle}" />
                                            <Button Content="打开目录" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="打开数据目录" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="默认下载目录" Style="{StaticResource LabelText}" />
                                        <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding DownloadFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="视频库\PCbox" AutomationProperties.Name="默认下载目录" />
                                            <Button Grid.Column="1" Content="浏览" Command="{Binding SelectDownloadFolderCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="批量下载保存到这里；单集另存仍可自行选择位置。清理缓存不会删除已下载视频。"
                                                   Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 2：分项清理与一键清缓存 -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="{StaticResource SpaceSmall}" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="分项快捷清理" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="全部缓存包含图片与元数据缓存；播放记录与收藏需确认后清除。" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <DropDownButton Grid.Column="1" Content="清理" VerticalAlignment="Center"
                                                        MinHeight="{StaticResource SecondaryButtonHeight}"
                                                        AutomationProperties.Name="清理">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Text="全部缓存" Command="{Binding ClearCachesCommand}" />
                                                    <MenuFlyoutItem Text="图片缓存" Command="{Binding ClearImagesCommand}" />
                                                    <MenuFlyoutItem Text="元数据缓存" Command="{Binding ClearMetadataCommand}" />
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="图片缓存" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="海报与剧照缩略图缓存" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="清除" Command="{Binding ClearImagesCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="元数据缓存" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="站点详情与搜索元数据" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="清除" Command="{Binding ClearMetadataCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="播放记录" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="继续观看与历史记录" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="清除" Click="OnClearHistoryClick"
                                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="收藏" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="跨站点收藏列表" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="清除" Click="OnClearFavoritesClick"
                                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 3：高级扫描清理 -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="高级扫描清理" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="先扫描再选择。应用缓存与 AI 字幕临时文件默认勾选；已下载媒体、临时目录与回收站需单独确认。"
                                                   Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                        <Button Content="扫描可清理项" Command="{Binding ScanCleanupCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                                AutomationProperties.Name="扫描可清理项" />
                                        <Button Content="清理选中项" Click="OnCleanSelectedClick" Style="{StaticResource PrimaryButtonStyle}"
                                                AutomationProperties.Name="清理选中项" />
                                        <ProgressRing Width="24" Height="24" IsActive="{Binding IsCleaning}"
                                                      Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                               Visibility="{Binding CleanupSummary, Converter={StaticResource StringToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding CleanupCategories}"
                                                  Visibility="{Binding HasCleanupResults, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" MinHeight="64" Padding="0,8"
                                                          HorizontalContentAlignment="Stretch">
                                                    <StackPanel Spacing="{StaticResource SpaceTiny}">
                                                        <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource MetaText}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 关于 ============ -->
                        <StackPanel x:Name="AboutPane" Spacing="16" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="关于" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="PCbox · 影视仓蓝主题桌面影院。" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="应用名称" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="PCbox" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="版本" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AppVersionText" Grid.Column="1" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="视觉语言" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="影视仓蓝 · 纯黑影院" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="数据安全" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="网盘凭据、百炼 API Key 与弹幕凭证均经当前用户 DPAPI 加密保存，日志自动脱敏。"
                                                   Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="{StaticResource SpaceSmall}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="{StaticResource SpaceTiny}" VerticalAlignment="Center">
                                            <TextBlock Text="软件更新" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="从 GitHub Releases 检查正式版本；下载校验后可自动安装。" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceMini}" VerticalAlignment="Center">
                                            <Button Content="下载安装" Command="{Binding ShowUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                                    AutomationProperties.Name="下载安装更新"
                                                    Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                                    AutomationProperties.Name="检查更新" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceTiny}">
                                            <TextBlock Text="自动检查更新" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="默认开启；启动时低频检查，播放中不会弹出更新窗口。" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoCheckUpdates, Mode=TwoWay}" OnContent="" OffContent=""
                                                      MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      AutomationProperties.Name="自动检查更新" />
                                    </Grid>
                                    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMini}">
                                <Button Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="查看诊断日志" Command="{Binding OpenDiagnosticsCommand}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="查看诊断日志" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 状态提示（导入、清理、登录结果） -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource MetaText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
