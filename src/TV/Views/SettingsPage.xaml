<Page x:Class="TV.Views.SettingsPage" x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TV.Controls"
      Background="Transparent" Loaded="OnLoaded">
    <Page.Resources>
        <!-- 设置页尺寸：左侧分区导航、表单标签列、内容最大宽度 -->
        <x:Double x:Key="SettingsNavWidth">172</x:Double>
        <x:Double x:Key="SettingsFormLabelWidth">124</x:Double>
        <x:Double x:Key="SettingsFormControlWidth">300</x:Double>
        <x:Double x:Key="SettingsContentMaxWidth">820</x:Double>
        <x:Double x:Key="SettingsRowMinHeight">52</x:Double>
        <Thickness x:Key="SettingsScrollPadding">4,0,20,24</Thickness>

        <!-- 左侧分区导航项：48 高、选中态＝影视仓蓝底 + 蓝色指示条；点击/展开切换右侧内容 -->
        <Style x:Key="SettingsNavSectionStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <ToggleButton x:Name="HeaderToggle"
                                      Content="{TemplateBinding Header}"
                                      Height="{StaticResource NavItemHeight}"
                                      Padding="0,0,12,0"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Background="Transparent" BorderThickness="0"
                                      CornerRadius="{StaticResource RadiusControl}"
                                      UseSystemFocusVisuals="True"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Padding="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Indicator" Width="3" Height="20" CornerRadius="{StaticResource RadiusTag}"
                                                Background="{ThemeResource SelectionIndicatorBrush}" Opacity="0"
                                                VerticalAlignment="Center" />
                                        <ContentPresenter x:Name="Presenter" Grid.Column="1"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Margin="8,0,0,0"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="Root.Background" Value="{ThemeResource NavHoverBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                            <VisualStateGroup x:Name="CheckStates">
                                                <VisualState x:Name="Unchecked" />
                                                <VisualState x:Name="Checked">
                                                    <VisualState.Setters>
                                                        <Setter Target="Root.Background" Value="{ThemeResource SelectionBrush}" />
                                                        <Setter Target="Indicator.Opacity" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Indeterminate" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePaddingWide}" RowSpacing="{StaticResource SpaceLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Spacing="{StaticResource SpaceTiny}">
            <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="片源、播放、弹幕与 AI、网盘、网络与外观设置，按分区切换查看。" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <!-- 左侧分区导航 + 右侧内容 -->
        <Grid Grid.Row="1" ColumnSpacing="{StaticResource SpaceLarge}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="{StaticResource SettingsNavWidth}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="0,0,16,0">
                <StackPanel Spacing="{StaticResource SpaceTiny}">
                    <!-- 片源 -->
                    <Expander x:Name="SourceSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="片源" ToolTipService.ToolTip="片源">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="片源" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 播放 -->
                    <Expander x:Name="PlaybackSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="播放" ToolTipService.ToolTip="播放">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="播放" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 弹幕与 AI -->
                    <Expander x:Name="AiSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="弹幕与 AI" ToolTipService.ToolTip="AI 字幕、翻译与弹弹play 弹幕">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xED1E;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="弹幕与 AI" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 网盘 -->
                    <Expander x:Name="CloudSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="网盘" ToolTipService.ToolTip="网盘">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE753;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="网盘" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 网络 -->
                    <Expander x:Name="NetworkSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="网络" ToolTipService.ToolTip="网络">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE839;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="网络" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 外观与内容 -->
                    <Expander x:Name="AppearanceSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="外观与内容" ToolTipService.ToolTip="外观与内容">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="外观与内容" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 存储 -->
                    <Expander x:Name="StorageSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="存储" ToolTipService.ToolTip="存储">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE7B8;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="存储" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                    <!-- 关于 -->
                    <Expander x:Name="AboutSection" Style="{StaticResource SettingsNavSectionStyle}"
                              AutomationProperties.Name="关于" ToolTipService.ToolTip="关于">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSmall}">
                                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="关于" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                    </Expander>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" RowSpacing="{StaticResource SpaceSmall}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 设置内容：右侧内容区的滚动容器（workspace_layout 断言按此名称取 bounds/滚动） -->
                <ScrollViewer x:Name="SettingsScroller" AutomationProperties.Name="设置内容"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                              Padding="{StaticResource SettingsScrollPadding}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="920" />
                        </Grid.ColumnDefinitions>
                        <!-- ============ 片源 ============ -->
                        <StackPanel x:Name="SourcePane" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="片源与接口" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="导入接口仓库、刷新内置接口，并确认当前生效的来源。" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="接口仓库管理" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="导入仓库" Style="{StaticResource PrimaryButtonStyle}">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                        <StackPanel Width="320" Spacing="{StaticResource SpaceSmall}"
                                                                    AutomationProperties.Name="仓库链接">
                                                            <TextBox Header="仓库链接"
                                                                     Text="{Binding NewSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     PlaceholderText="https://" InputScope="Url" />
                                                            <Button Content="导入" Command="{Binding AddSourceCommand}"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Content="刷新接口" Command="{Binding ReloadCommand}"
                                                    Height="{StaticResource PrimaryButtonHeight}" MinHeight="{StaticResource PrimaryButtonHeight}"
                                                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="已导入仓库" Style="{StaticResource LabelText}" />
                                        <ItemsControl ItemsSource="{Binding ImportedRepositories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                                                            Padding="0,10">
                                                        <Grid ColumnSpacing="{StaticResource SpaceMedium}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="{StaticResource SpaceTiny}">
                                                                <TextBlock Text="{Binding Url}" Style="{StaticResource BodyText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTipService.ToolTip="{Binding Url}" />
                                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MetaText}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                                    Tag="{Binding}" Click="OnRemoveSourceClick"
                                                                    ToolTipService.ToolTip="删除仓库"
                                                                    AutomationProperties.Name="删除仓库">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="自动刷新接口" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="启动时自动检查并更新片源配置" Style="{StaticResource MetaText}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoRefreshSources, Mode=TwoWay}"
                                                      OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="当前生效来源" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding ActiveSource}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastSourceRefresh}" Style="{StaticResource MetaText}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 播放 ============ -->
                        <StackPanel x:Name="PlaybackPane" Spacing="16" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="播放" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="解码、连播与缓存策略；修改即时保存。" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="硬件解码" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding HardwareDecoding, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="弱网自动画质" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding AdaptiveQuality, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="自动连播" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoNext, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="续播" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding ResumePlayback, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="失败自动切线" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoSwitchLine, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="缓存与画质" Style="{StaticResource LabelText}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="点播缓存 (ms)" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <NumberBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}" Minimum="1200" Maximum="12000" SpinButtonPlacementMode="Inline" Value="{Binding NetworkCache, Mode=TwoWay}" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="直播缓存 (ms)" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <NumberBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}" Minimum="500" Maximum="8000" SpinButtonPlacementMode="Inline" Value="{Binding LiveCache, Mode=TwoWay}" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="默认音量" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <NumberBox Grid.Column="1" MinWidth="160" MaxWidth="{StaticResource SettingsFormControlWidth}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Value="{Binding DefaultVolume, Mode=TwoWay}" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="默认画质" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <controls:AnchoredChoice Grid.Column="1" Header="默认画质" Options="自动|原画|1080p|720p|420p" SelectedIndex="{Binding DefaultQualityIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 弹幕与 AI ============ -->
                        <StackPanel x:Name="AiPane" Spacing="16" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="AI 字幕与弹幕" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="配置阿里云百炼 AI 自动生成/翻译字幕，以及弹弹play 开放弹幕库；所有密钥均使用本机 DPAPI 加密保存。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 阿里云百炼 API Key -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="阿里云百炼 API Key" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding BailianKeyStatus}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往百炼生成密钥" Command="{Binding OpenBailianConsoleCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                                                AutomationProperties.Name="前往阿里云百炼生成 API Key" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="API Key" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <PasswordBox Grid.Column="1" MinWidth="240" MaxWidth="380" HorizontalAlignment="Left"
                                                     PlaceholderText="粘贴阿里云百炼密钥 (sk-...)"
                                                     Password="{Binding BailianApiKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="阿里云百炼 API Key" />
                                    </Grid>
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="百炼服务区域" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <controls:AnchoredChoice Grid.Column="1" Header="服务区域" MinWidth="200"
                                                                 Options="中国内地（北京）|国际节点（新加坡）"
                                                                 SelectedIndex="{Binding BailianRegionIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="加密保存" Command="{Binding SaveBailianKeyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="验证连通性" Command="{Binding VerifyBailianKeyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="清除密钥" Command="{Binding ClearBailianKeyCommand}" Style="{StaticResource GhostButtonStyle}" />
                                        <ProgressRing Width="20" Height="20" IsActive="{Binding IsTestingAi}"
                                                      Visibility="{Binding IsTestingAi, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- AI 模型与字幕偏好 -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="AI 字幕与翻译模型" Style="{StaticResource LabelText}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字幕生成模型" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <controls:AnchoredChoice Header="语音转字幕模型" MinWidth="280"
                                                                     Options="paraformer-v2（便宜）|qwen3-asr-flash-filetrans（准确 · 支持实时字幕）"
                                                                     SelectedIndex="{Binding AsrModelIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding AsrModelHint}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                    <Grid MinHeight="{StaticResource SettingsRowMinHeight}" ColumnSpacing="{StaticResource SpaceLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字幕翻译模型" Style="{StaticResource LabelText}" Width="{StaticResource SettingsFormLabelWidth}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <controls:AnchoredChoice Header="翻译模型" MinWidth="280"
