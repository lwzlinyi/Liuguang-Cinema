                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding AiRealtimeTranslate, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
