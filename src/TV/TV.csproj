<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <RootNamespace>TV</RootNamespace>
    <AssemblyName>TV</AssemblyName>
    <AssemblyTitle>PCbox</AssemblyTitle>
    <Description>PCbox · Windows 原生桌面影院播放器</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <Import Project="Secrets.Local.props" Condition="Exists('Secrets.Local.props')" />
  <PropertyGroup>
    <DanDanPlayAppId Condition="'$(DanDanPlayAppId)' == ''">$(DANDANPLAY_APP_ID)</DanDanPlayAppId>
    <DanDanPlayAppSecret1 Condition="'$(DanDanPlayAppSecret1)' == ''">$(DANDANPLAY_APP_SECRET_1)</DanDanPlayAppSecret1>
    <DanDanPlayAppSecret2 Condition="'$(DanDanPlayAppSecret2)' == ''">$(DANDANPLAY_APP_SECRET_2)</DanDanPlayAppSecret2>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DanDanPlayAppId" Value="$(DanDanPlayAppId)" />
    <AssemblyMetadata Include="DanDanPlayAppSecret1" Value="$(DanDanPlayAppSecret1)" />
    <AssemblyMetadata Include="DanDanPlayAppSecret2" Value="$(DanDanPlayAppSecret2)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="LibVLCSharp" Version="3.9.*" />
    <PackageReference Include="LibVLCSharp.WinUI" Version="3.9.*" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="4.156.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.*" />
    <PackageReference Include="AngleSharp" Version="1.2.*" />
   </ItemGroup>
</Project>
