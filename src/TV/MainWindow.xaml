<Window
    x:Class="TV.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ShellRoot" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PaneColumn" Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧栏：品牌 + 全局搜索 + 一级导航（点播/直播/媒体库/云盘/投屏）+ 设置 -->
        <Border x:Name="NavPane" Grid.Column="0" Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid x:Name="NavPaneContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="BrandBlock" Grid.Row="0" Orientation="Horizontal" Spacing="11"
                            Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#42A5F5" Offset="0" />
                                <GradientStop Color="#1976D2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE768;" FontSize="12" Margin="2,0,0,0"
                                  Foreground="{ThemeResource AccentInkBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="BrandText" Text="PCbox" FontSize="{StaticResource FontSizeCardTitle}" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFontFamily}" CharacterSpacing="20"
                               Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 全局快捷搜索入口（Ctrl+F），窄窗自动折叠为图标 -->
                <Button x:Name="NavSearchButton" Grid.Row="1" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,4,10,6" Height="38" MinHeight="38" Padding="12,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Click="OnSearchNavClick"
                        ToolTipService.ToolTip="全站搜索 (Ctrl+F)" AutomationProperties.Name="全站搜索">
                    <Grid x:Name="NavSearchContent" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavSearchLabel" Grid.Column="1" Text="搜索片库" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NavSearchHint" Grid.Column="2" Text="Ctrl+F" Style="{StaticResource MetaText}"
                                   Opacity="0.65" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <ListView x:Name="NavList" Grid.Row="2" Margin="0,4,0,0" Padding="0,0,0,8"
                          Background="Transparent" BorderThickness="0"
                          SelectionMode="Single" IsItemClickEnabled="False"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          SelectionChanged="OnNavSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="NavRailItemStyle" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListViewItem Tag="vod" AutomationProperties.Name="点播" ToolTipService.ToolTip="点播">
                        <StackPanel x:Name="NavContentVod" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8B2;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelVod" Text="点播" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="live" AutomationProperties.Name="直播" ToolTipService.ToolTip="直播">
                        <StackPanel x:Name="NavContentLive" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE7F4;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelLive" Text="直播" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="library" AutomationProperties.Name="媒体库" ToolTipService.ToolTip="媒体库">
                        <StackPanel x:Name="NavContentLibrary" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8A9;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelLibrary" Text="媒体库" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="cloud" AutomationProperties.Name="云盘" ToolTipService.ToolTip="我的云盘">
                        <StackPanel x:Name="NavContentCloud" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE753;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelCloud" Text="云盘" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="cast" AutomationProperties.Name="投屏" ToolTipService.ToolTip="投屏">
                        <StackPanel x:Name="NavContentCast" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xEC15;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelCast" Text="投屏" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="16,4,16,8" />
                    <Button x:Name="SettingsButton" Style="{StaticResource GhostButtonStyle}"
                            Margin="8,0,8,0" Height="{StaticResource NavItemHeight}" Padding="17,0,14,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnSettingsClick" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置">
                        <StackPanel x:Name="NavContentSettings" Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE713;" FontSize="19" Width="24" />
                            <TextBlock x:Name="NavLabelSettings" Text="设置" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 物理弹簧滑行的全局侧栏指示条（跨点播/直播/媒体库/云盘/投屏/设置丝滑过渡） -->
                <Border x:Name="FloatingNavIndicator" Grid.RowSpan="4"
                        Width="3.5" Height="22" CornerRadius="2"
                        Background="{ThemeResource SelectionIndicatorBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,0,0,0" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- 右侧：标题栏操作区 + 影视仓式全局导航条 + 页面内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent"
                  Loaded="OnTitleBarLoaded" SizeChanged="OnTitleBarSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}"
                        Background="Transparent" BorderThickness="0" Opacity="0" IsHitTestVisible="False"
                        Margin="12,0,0,0" Click="OnBackClick"
                        ToolTipService.ToolTip="返回 (Alt+←)" AutomationProperties.Name="返回">
                    <FontIcon Glyph="&#xE72B;" FontSize="18" />
                </Button>

                <!-- 影视仓式右上角实时时间 -->
                <TextBlock x:Name="ClockText" Grid.Column="1" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,150,0" FontSize="13"
                           Foreground="{ThemeResource SecondaryTextBrush}" IsHitTestVisible="False" />

            </Grid>

            <!-- 影视仓式全局顶部导航条：历史/直播/搜索/配置/线路/本地/收藏/推送/设置 -->
            <Border x:Name="TopNavBar" Grid.Row="1" Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="14,5">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 左上角品牌字样（侧栏隐藏后改为固定在导航条左侧，不随滚动移走） -->
                    <TextBlock Text="PCbox" FontSize="20" FontWeight="Bold"
                               FontFamily="{StaticResource DisplayFontFamily}" CharacterSpacing="20"
                               Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"
                               AutomationProperties.Name="PCbox" />
                    <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopHistoryClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="历史">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE81C;" FontSize="16" /><TextBlock Text="历史" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopLiveClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="直播">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7F4;" FontSize="16" /><TextBlock Text="直播" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopSearchClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="搜索">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE721;" FontSize="16" /><TextBlock Text="搜索" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopConfigClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="配置">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock Text="配置" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopLineClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="线路">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock Text="线路" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopLocalClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="本地">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock Text="本地" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopFavoriteClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="收藏">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE734;" FontSize="16" /><TextBlock Text="收藏" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnTopPushClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="推送">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72D;" FontSize="16" /><TextBlock Text="推送" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Click="OnSettingsClick" Height="36" MinHeight="36" Padding="14,0" AutomationProperties.Name="设置">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock Text="设置" FontSize="15" Foreground="#F2F3F5" /></StackPanel>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="2" Background="Transparent" />
        </Grid>

        <!-- 关闭行为面板锚点（贴在标题栏右上，系统按钮下方） -->
        <Border x:Name="ClosePromptAnchor" Width="46" Height="32" HorizontalAlignment="Right"
                VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
</Window>
