<!--
    PCbox · 设计令牌
    视觉方向：「影视仓 · 纯黑底 + 影视仓蓝高亮」。内容优先、高密度、强对比：
    紧凑网格、小字号、蓝色只用在选中态与高频操作上。
    所有颜色、字号、间距、控件尺寸都从这里取，页面里禁止另写数字。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         1. 语义颜色
         ============================================================ -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- 表面 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0A0C" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#121317" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A1B20" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#24252B" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#1E1F25" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#1A1B20" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#DF000000" />
            <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C4000000" Offset="0" />
                <GradientStop Color="#E6000000" Offset="0.52" />
                <GradientStop Color="#FA000000" Offset="1" />
            </LinearGradientBrush>

            <!-- 文本 -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F2EC" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A4ADBC" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#788292" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="#11141A" />

            <!-- 边框 -->
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="#36FFFFFF" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#662196F3" />

            <!-- 影视仓蓝强调 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#2196F3" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#2196F3" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#42A5F5" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#1976D2" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#222196F3" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#1F2196F3" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="#2196F3" />

            <!-- 状态 -->
            <SolidColorBrush x:Key="DangerBrush" Color="#FF7A72" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#2EFF7A72" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#63D6A4" />
            <SolidColorBrush x:Key="RatingBrush" Color="#FFD54A" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#14FFFFFF" />

            <!-- 兼容旧键 -->
            <SolidColorBrush x:Key="GlassBrush" Color="#13161D" />
            <SolidColorBrush x:Key="CardBrush" Color="#191D26" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="#171B24" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F7" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#ECEEF0" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E9E3D9" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#E6E7E9" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#D9F5F1E9" />
            <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C4FFFFFF" Offset="0" />
                <GradientStop Color="#E6FFFFFF" Offset="0.52" />
                <GradientStop Color="#FAFFFFFF" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17191E" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#565E6B" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#78808C" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="#26000000" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#592196F3" />

            <SolidColorBrush x:Key="AccentBrush" Color="#1565C0" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#2196F3" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#42A5F5" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#1976D2" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#262196F3" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#262196F3" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="#1976D2" />

            <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FB42318" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#1E7A52" />
            <SolidColorBrush x:Key="RatingBrush" Color="#B45309" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#0F000000" />

            <SolidColorBrush x:Key="GlassBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBrush" Color="#ECEEF0" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HeroScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnInverseTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RatingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PillIdleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PillActiveInkBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 系统强调色：影视仓蓝。默认控件的 Focus/Hover/Accent 都从这里派生。 -->
    <Color x:Key="SystemAccentColor">#FF2196F3</Color>
    <Color x:Key="SystemAccentColorLight1">#FF42A5F5</Color>
    <Color x:Key="SystemAccentColorLight2">#FF64B5F6</Color>
    <Color x:Key="SystemAccentColorLight3">#FF90CAF9</Color>
    <Color x:Key="SystemAccentColorDark1">#FF1976D2</Color>
    <Color x:Key="SystemAccentColorDark2">#FF1565C0</Color>
    <Color x:Key="SystemAccentColorDark3">#FF0D47A1</Color>

    <!-- ============================================================
         2. 字体
         ============================================================ -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>

    <!-- 字阶（px） -->
    <x:Double x:Key="FontSizeHero">26</x:Double>
    <x:Double x:Key="FontSizePageTitle">22</x:Double>
    <x:Double x:Key="FontSizeSection">17</x:Double>
    <x:Double x:Key="FontSizeCardTitle">13</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSecondary">12</x:Double>
    <x:Double x:Key="FontSizeMeta">11</x:Double>

    <!-- 行高 -->
    <x:Double x:Key="LineHeightHero">33</x:Double>
    <x:Double x:Key="LineHeightPageTitle">29</x:Double>
    <x:Double x:Key="LineHeightSection">23</x:Double>
    <x:Double x:Key="LineHeightCardTitle">18</x:Double>
    <x:Double x:Key="LineHeightBody">19</x:Double>
    <x:Double x:Key="LineHeightSecondary">17</x:Double>
    <x:Double x:Key="LineHeightMeta">15</x:Double>

    <!-- ============================================================
         3. 间距（4px 网格）
         ============================================================ -->
    <x:Double x:Key="SpaceTiny">3</x:Double>
    <x:Double x:Key="SpaceMini">6</x:Double>
    <x:Double x:Key="SpaceSmall">9</x:Double>
    <x:Double x:Key="SpaceMedium">12</x:Double>
    <x:Double x:Key="SpaceLarge">18</x:Double>
    <x:Double x:Key="SpaceXLarge">24</x:Double>
    <x:Double x:Key="SpaceHuge">36</x:Double>

    <!-- 页面外边距：标题栏已提供顶部留白，页面上边距克制收紧以让内容区首屏更饱满 -->
    <Thickness x:Key="PagePaddingWide">18,6,18,18</Thickness>
    <Thickness x:Key="PagePaddingStandard">14,6,14,16</Thickness>
    <Thickness x:Key="PagePaddingNarrow">10,6,10,14</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,16</Thickness>
    <Thickness x:Key="GroupGap">0,0,0,10</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="ControlPaddingHorizontal">16,0</Thickness>

    <!-- ============================================================
         4. 控件尺寸与圆角
         ============================================================ -->
    <x:Double x:Key="NavItemHeight">40</x:Double>
    <x:Double x:Key="PrimaryButtonHeight">36</x:Double>
    <x:Double x:Key="SecondaryButtonHeight">32</x:Double>
    <x:Double x:Key="IconButtonSize">34</x:Double>
    <x:Double x:Key="InputHeight">36</x:Double>
    <x:Double x:Key="MenuItemHeight">34</x:Double>
    <x:Double x:Key="ListRowHeight">40</x:Double>

    <!-- 圆角规范（4px 网格派生）：微观件 4 / 控件 8 / 标签胶囊 10 / 卡片 12 / 大面板 16 / 圆形 999 -->
    <CornerRadius x:Key="RadiusTag">2</CornerRadius>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusChip">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">10</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <x:Double x:Key="CardRadius">6</x:Double>

    <!-- 海报 -->
    <x:Double x:Key="PosterWidth">150</x:Double>
    <x:Double x:Key="PosterHeight">225</x:Double>
    <x:Double x:Key="PosterWidthCompact">140</x:Double>
    <x:Double x:Key="PosterHeightCompact">210</x:Double>
    <x:Double x:Key="PosterColumnGap">10</x:Double>
    <x:Double x:Key="PosterRowGap">12</x:Double>
    <x:Double x:Key="PosterMaxWidth">720</x:Double>

    <!-- 侧栏 -->
    <x:Double x:Key="NavPaneWidth">196</x:Double>
    <x:Double x:Key="NavPaneCompactWidth">76</x:Double>
    <x:Double x:Key="TitleBarHeight">40</x:Double>

    <!-- 正文可读宽度上限 -->
    <x:Double x:Key="ReadableMaxWidth">840</x:Double>
    <x:Double x:Key="TextParagraphMaxWidth">800</x:Double>

    <!-- ============================================================
         6. 文本样式（全站唯一入口）
         ============================================================ -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightPageTitle}" />
    </Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSecondary}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightMeta}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SelectableText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>


</ResourceDictionary>
