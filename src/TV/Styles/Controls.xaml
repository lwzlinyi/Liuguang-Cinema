    <!-- ============================================================
         控件样式：尺寸与状态全部来自 Tokens.xaml
         ============================================================ -->

    <!-- 主操作：影视仓蓝填充 + 墨色字，44 高 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="{StaticResource PrimaryButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource PrimaryButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource ControlPaddingHorizontal}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- 次操作：表面色 + 细描边，40 高 -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource SecondaryButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource SecondaryButtonHeight}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- 影视仓顶部功能按钮：深灰实心圆角 + 白字 -->
    <Style x:Key="TopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="#232428" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 纯文字操作 -->
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource SecondaryButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource SecondaryButtonHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>

    <!-- 图标按钮 40×40 -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MinWidth" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MinHeight" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 播放器等暗色场景的图标按钮 -->
    <Style x:Key="PlayerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 筛选胶囊：轻量椭圆胶囊，未选克制通透、选中影视仓蓝淡底 + 影视仓蓝字 + 影视仓蓝描边 -->
    <Style x:Key="FilterChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- 侧栏导航项：48 高，选中影视仓蓝底 + 蓝色指示条 -->
    <Style x:Key="NavRailItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource NavItemHeight}" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                        <Border x:Name="SelectionPlate" Background="{ThemeResource SelectionBrush}" CornerRadius="8" Opacity="0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="3" Height="20" CornerRadius="2"
                                    Background="{ThemeResource SelectionIndicatorBrush}" Opacity="0"
                                    VerticalAlignment="Center" />
                            <ContentPresenter x:Name="Presenter" Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource NavHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="0" />
                                        <Setter Target="Indicator.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPlate.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MultiSelectStates">
                                <VisualState x:Name="MultiSelectDisabled" />
                                <VisualState x:Name="MultiSelectEnabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页面内导航列表（站点/分组等）：留出与左侧 3px 指示条的安全呼吸间距，杜绝文字贴边碰撞 -->
    <Style x:Key="RailListStyle" TargetType="ListViewItem" BasedOn="{StaticResource NavRailItemStyle}">
        <Setter Property="Padding" Value="12,0,14,0" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- 面板：深邃浮层卡片 -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- 设置分组卡片：全宽沉稳分层容器 -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- 兼容旧键 -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style x:Key="PosterGridItem" TargetType="GridViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,18,22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- 输入框全站 44 高，垂直内边距 10px 确保占位符与正文光学居中 -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
</ResourceDictionary>
