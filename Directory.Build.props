<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>1.8.1</Version>
    <AssemblyVersion>1.8.1.0</AssemblyVersion>
    <FileVersion>1.8.1.0</FileVersion>
    <Product>PCbox</Product>
    <Company>Liuguang Cinema Contributors</Company>
    <Authors>Liuguang Cinema Contributors</Authors>
    <Copyright>Copyright (c) Liuguang Cinema Contributors. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/binchen6/Liuguang-Cinema</RepositoryUrl>
  </PropertyGroup>
</Project>
